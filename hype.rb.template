class Hype < Formula
  desc "Render images as high-fidelity terminal text art"
  homepage "https://github.com/ackertyson/hype"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/ackertyson/hype/releases/download/v@@VERSION@@/hype-@@VERSION@@-aarch64-apple-darwin.tar.gz"
      sha256 "@@SHA256_AARCH64_APPLE_DARWIN@@"
    end
    on_intel do
      url "https://github.com/ackertyson/hype/releases/download/v@@VERSION@@/hype-@@VERSION@@-x86_64-apple-darwin.tar.gz"
      sha256 "@@SHA256_X86_64_APPLE_DARWIN@@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/ackertyson/hype/releases/download/v@@VERSION@@/hype-@@VERSION@@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@@"
    end
    on_intel do
      url "https://github.com/ackertyson/hype/releases/download/v@@VERSION@@/hype-@@VERSION@@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@@SHA256_X86_64_UNKNOWN_LINUX_MUSL@@"
    end
  end

  def install
    bin.install "hype"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/hype --version")

    %w[test.png test.jpg].each do |image|
      output = shell_output("#{bin}/hype #{test_fixtures(image)} -w 8 -H 4 -c true")
      assert_equal 4, output.lines.count
      assert_match "\e[48;2;", output
    end
  end
end
